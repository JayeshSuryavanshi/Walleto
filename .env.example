# Copy to `.env` and adjust. `.env` is git-ignored. Do NOT commit real secrets.

# ---- MySQL ----
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=amigowallet_db
MYSQL_USER=walleto
MYSQL_PASSWORD=change_me_app

# ---- wallet-api ----
# HS256 signing key for JWTs. MUST be >= 32 bytes. Generate: openssl rand -base64 48
APP_JWT_SECRET=change_me_to_a_random_secret_of_at_least_32_bytes
APP_JWT_ACCESS_TTL=1800
APP_JWT_RESET_TTL=600
# Comma-separated browser origins allowed to call the API (the web app).
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4200

# ---- bank-api (service-to-service) ----
# Shared secret the wallet-api presents to the bank-api (X-Service-Auth header).
BANK_SERVICE_API_KEY=change_me_bank_service_key

# ---- wallet-api -> bank-api wiring (used from Phase 4 onward) ----
BANK_API_BASE_URL=http://bank-api:3331/EDUBank
